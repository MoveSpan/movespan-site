<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MoveSpan System — Daily Measurements</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="manifest" href="/manifest.json">
<meta name="apple-mobile-web-app-capable" content="yes">
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --green:#2D7D52;--gl:#E8F5EE;--gb:#A8D5B8;
  --text:#1A1A1A;--sec:#5A6370;--muted:#9AA3AD;
  --border:#E2E6EA;--surface:#F7F9FB;--white:#FFFFFF;
  --orange:#F59E0B;--radius:14px;--font:'Inter',system-ui,sans-serif;
}
body{font-family:var(--font);background:var(--surface);color:var(--text);min-height:100vh}
.wrap{max-width:560px;margin:0 auto;padding:1.5rem 1.25rem 4rem}
.logo{display:flex;align-items:center;gap:10px;margin-bottom:1.5rem}
.logo-icon{width:40px;height:40px;border-radius:11px;overflow:hidden;flex-shrink:0}
.logo-name{font-size:15px;font-weight:600}
.back{font-size:13px;color:var(--green);font-weight:500;margin-bottom:1.25rem;display:block;text-decoration:none;cursor:pointer;background:none;border:none;font-family:var(--font);padding:0;text-align:left}
.card{background:var(--white);border-radius:20px;padding:1.75rem;box-shadow:0 1px 6px rgba(0,0,0,.07);margin-bottom:1rem}
.sec{display:none}.sec.active{display:block;animation:fadeIn .25s ease}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.step-label{font-size:11px;font-weight:600;color:var(--green);text-transform:uppercase;letter-spacing:.06em;margin-bottom:6px}
.title{font-size:22px;font-weight:600;margin-bottom:8px;letter-spacing:-.02em}
.sub{font-size:14px;color:var(--sec);line-height:1.7;margin-bottom:1.25rem}
/* posture */
.posture-box{background:var(--surface);border-radius:14px;padding:14px;margin-bottom:1rem;border-left:3px solid var(--green)}
.posture-item{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--sec);margin-bottom:6px}
.posture-item:last-child{margin-bottom:0}
.pi{font-size:16px;width:22px;text-align:center;flex-shrink:0}
/* hint */
.hint{background:#FEF9EC;border-radius:10px;padding:10px 12px;font-size:12px;color:#92400E;line-height:1.55;margin-bottom:1.25rem;display:flex;gap:8px;align-items:flex-start}
/* timer */
.timer-wrap{display:flex;flex-direction:column;align-items:center;margin:1.25rem 0}
.timer-ring{position:relative;width:160px;height:160px}
.timer-ring svg{transform:rotate(-90deg)}
circle{fill:none;stroke-width:8}
.ring-bg{stroke:#E2E6EA}
.ring-calm{stroke:#A8D5B8;stroke-linecap:round;stroke-dasharray:440}
.ring-count{stroke:#2D7D52;stroke-linecap:round;stroke-dasharray:440;transition:stroke-dashoffset 1s linear}
.timer-num{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:42px;font-weight:600;letter-spacing:-.03em}
.timer-sub{font-size:13px;color:var(--muted);margin-top:8px;text-align:center}
/* hybrid input */
.hybrid-label{font-size:13px;font-weight:600;margin-bottom:10px}
.hybrid-row{display:flex;align-items:flex-start;gap:12px;margin-bottom:10px}
.hybrid-input{width:100px;padding:14px;border:1.5px solid var(--border);border-radius:12px;font-size:32px;font-weight:600;font-family:var(--font);text-align:center;color:var(--text)}
.hybrid-input:focus{outline:none;border-color:var(--green)}
.hybrid-unit{font-size:13px;color:var(--muted);padding-top:20px}
.hybrid-watch{flex:1;background:var(--surface);border-radius:12px;padding:10px 12px;font-size:12px;color:var(--sec);line-height:1.5;border:1px solid var(--border)}
.hybrid-watch b{color:var(--text);display:block;margin-bottom:2px}
.manual-link{font-size:12px;color:var(--muted);margin-bottom:1.25rem}
.manual-link button{background:none;border:none;color:var(--green);font-size:12px;font-weight:600;cursor:pointer;font-family:var(--font)}
/* interpretation */
.interp{border-radius:10px;padding:9px 12px;font-size:13px;line-height:1.5;margin-bottom:1.25rem;display:none;align-items:center;gap:8px}
.interp.show{display:flex}
.interp.great{background:var(--gl);border:1px solid var(--gb);color:var(--green)}
.interp.ok{background:#F0FDF4;border:1px solid #86EFAC;color:#166534}
.interp.warn{background:#FEF9EC;border:1px solid var(--orange);color:#92400E}
.interp.high{background:#FEE2E2;border:1px solid #FCA5A5;color:#DC2626}
.interp-icon{font-size:18px;flex-shrink:0}
.interp-text b{display:block;font-weight:600;margin-bottom:2px}
.interp-text small{font-size:11px;opacity:.85}
/* why */
.why-btn{background:var(--gl);border:1.5px solid var(--gb);border-radius:20px;font-size:12px;font-weight:500;color:var(--green);padding:7px 16px;cursor:pointer;font-family:var(--font);margin-bottom:1.25rem;display:inline-block}
.why-panel{display:none;background:var(--surface);border-radius:14px;padding:14px;margin-bottom:1.25rem;border-left:3px solid var(--green);font-size:13px;color:var(--sec);line-height:1.75}
.why-panel.open{display:block}
.why-panel b{color:var(--text);font-weight:600}
.listen-btn{background:var(--white);border:1px solid var(--border);border-radius:16px;font-size:11px;color:var(--sec);padding:4px 10px;margin-bottom:8px;display:inline-block;cursor:pointer;font-family:var(--font)}
.ranges{margin-top:10px;display:flex;flex-direction:column;gap:5px}
.rng{display:flex;gap:8px;font-size:12px}
.rng-val{width:84px;font-weight:600;flex-shrink:0}
.rng-val.g{color:var(--green)}.rng-val.ok{color:#166534}
.rng-val.w{color:#92400E}.rng-val.r{color:#DC2626}
/* buttons */
.btn-primary{width:100%;padding:14px;background:var(--green);color:white;border:none;border-radius:var(--radius);font-size:15px;font-weight:500;font-family:var(--font);cursor:pointer;margin-bottom:8px;transition:opacity .15s}
.btn-primary:hover{opacity:.88}
.btn-primary:disabled{background:var(--gl);border:1.5px solid var(--gb);color:var(--green);cursor:not-allowed;opacity:1}
.btn-amber{width:100%;padding:12px;background:#FEF9EC;border:1.5px solid var(--orange);border-radius:var(--radius);font-size:13px;font-weight:500;color:#92400E;font-family:var(--font);cursor:pointer}
/* result summary */
.result-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
.result-name{font-size:13px;color:var(--sec)}
.result-val{font-size:13px;font-weight:600}
.result-action{font-size:13px;line-height:1.7;background:var(--surface);border-radius:12px;padding:12px 14px;margin-bottom:1.25rem}
/* count manual screen */
.count-box{background:var(--surface);border-radius:14px;padding:14px;text-align:center;margin-bottom:1.25rem}
.count-label{font-size:13px;color:var(--sec);margin-bottom:10px;line-height:1.5}
.count-input{width:120px;padding:14px;border:1.5px solid var(--border);border-radius:12px;font-size:32px;font-weight:600;font-family:var(--font);text-align:center;color:var(--text)}
.count-unit{font-size:12px;color:var(--muted);margin-top:6px}
</style>
</head>
<body>
<div class="wrap">
  <div class="logo">
    <div class="logo-icon" id="logo-wrap"><img src="data:image/png;base64," style="width:100%;height:100%;object-fit:cover;display:block;" alt="MoveSpan"></div>
    <span class="logo-name">MoveSpan System</span>
  </div>

  <!-- STEP 0: PREPARATION -->
  <div class="sec active" id="s-prep">
    <div class="card">
      <button class="back" onclick="window.location.href='/program'">← Back to program</button>
      <div class="step-label">Preparation · 1 minute</div>
      <div class="title">Get into a resting state first</div>
      <div class="posture-box">
        <div class="posture-item"><span class="pi">🪑</span> Sit with your spine straight, both feet flat on the floor</div>
        <div class="posture-item"><span class="pi">🙌</span> Hands relaxed on your knees, palms down</div>
        <div class="posture-item"><span class="pi">😌</span> Close your eyes. Breathe naturally — don&rsquo;t change anything</div>
        <div class="posture-item"><span class="pi">🤫</span> Stay completely still for 1 minute</div>
      </div>
      <div class="hint"><span style="font-size:16px;flex-shrink:0">💡</span><span>Measure at the same time each day — ideally morning, before food or practice. Pulse changes even from talking — give the body a full minute to settle.</span></div>
      <div class="timer-wrap">
        <div class="timer-ring">
          <svg width="160" height="160" viewBox="0 0 160 160">
            <circle class="ring-bg" cx="80" cy="80" r="70"/>
            <circle class="ring-calm" id="prep-ring" cx="80" cy="80" r="70" style="stroke-dashoffset:440"/>
          </svg>
          <div class="timer-num" id="prep-num">1:00</div>
        </div>
        <div class="timer-sub" id="prep-sub">Press Start when comfortable</div>
      </div>
      <button class="btn-primary" id="prep-btn" onclick="startPrep()">▶ Start 1-minute rest</button>
      <button id="prep-skip-btn" onclick="skipPrep()" style="width:100%;padding:11px;background:var(--gl);border:1.5px solid var(--gb);border-radius:14px;font-size:13px;font-weight:500;color:var(--green);font-family:var(--font);cursor:pointer;margin-top:8px">I’m already rested — measure now →</button>
    </div>
  </div>

  <!-- STEP 1: PULSE -->
  <div class="sec" id="s-pulse">
    <div class="card">
      <div class="step-label">Step 1 of 2 · Resting Pulse</div>
      <div class="title">Enter your resting pulse</div>
      <div class="hybrid-label">Your pulse right now:</div>
      <div class="hybrid-row">
        <input class="hybrid-input" type="number" id="pulse-val" placeholder="—" min="30" max="150" oninput="interpPulse()">
        <span class="hybrid-unit">bpm</span>
        <div class="hybrid-watch"><b>⌚ From your watch?</b>Check the current heart rate on your smartwatch and enter it here</div>
      </div>
      <div class="manual-link">Don&rsquo;t have a watch? <button onclick="showManualPulse()">Count manually with timer ↓</button></div>

      <!-- manual count (hidden by default) -->
      <div id="manual-pulse-wrap" style="display:none">
        <div class="hint"><span style="font-size:16px;flex-shrink:0">🤲</span><span>Place 2 fingers on your wrist (inner side, below thumb) or on your neck. Press Start and count every beat for 1 minute.</span></div>
        <div class="timer-wrap">
          <div class="timer-ring">
            <svg width="160" height="160" viewBox="0 0 160 160">
              <circle class="ring-bg" cx="80" cy="80" r="70"/>
              <circle class="ring-count" id="pulse-ring" cx="80" cy="80" r="70" style="stroke-dashoffset:440"/>
            </svg>
            <div class="timer-num" id="pulse-timer-num">1:00</div>
          </div>
          <div class="timer-sub" id="pulse-timer-sub">Press Start to begin counting</div>
        </div>
        <button class="btn-primary" id="pulse-timer-btn" onclick="startPulseTimer()">▶ Start 1-minute count</button>
        <div class="hint" style="display:none" id="pulse-screen-hint"><span style="font-size:16px;flex-shrink:0">📵</span><span>You can lock your screen — a sound will signal when the minute is up.</span></div>
        <div id="pulse-count-wrap" style="display:none">
          <div class="count-box">
            <div class="count-label">How many beats did you count during 1 minute?</div>
            <input class="count-input" type="number" id="pulse-count-input" placeholder="—" oninput="document.getElementById('pulse-val').value=this.value;interpPulse()">
            <div class="count-unit">beats per minute</div>
          </div>
        </div>
      </div>

      <div class="interp" id="interp-pulse"></div>

      <button class="why-btn" onclick="toggleWhy('why-pulse')">💡 Why does resting pulse matter? ↓</button>
      <div class="why-panel" id="why-pulse">
        <button class="listen-btn" onclick="speakWhy('why-pulse-text',this)">🔊 Listen</button>
        <div id="why-pulse-text">
          <p>Resting pulse shows how hard your heart works when the body is doing nothing. The higher it is, the more effort your system spends just maintaining baseline.</p>
          <p style="margin-top:8px">A high resting pulse means the <b>sympathetic nervous system («fight or flight») is dominant</b> — blood vessels are narrowed, muscles slightly tensed, internal pressure elevated. The body is bracing for a threat that isn't there. This is chronic background stress — most people don't notice it because they've come to accept it as normal.</p>
          <p style="margin-top:8px">Our practices lower resting pulse by activating the vagus nerve — <b>Svistyelka, slow exhales, joint gymnastics with breath, Shavasana</b>. This is why long-term yoga practitioners often have a resting pulse of 45–55 bpm: not from running, but from teaching the nervous system to truly rest.</p>
          <div class="ranges">
            <div class="rng"><span class="rng-val g">Below 60</span><span>Excellent — nervous system recovers well</span></div>
            <div class="rng"><span class="rng-val ok">60–75</span><span>Normal — room for improvement</span></div>
            <div class="rng"><span class="rng-val w">75–85</span><span>Elevated — sympathetic dominance, background tension</span></div>
            <div class="rng"><span class="rng-val r">Above 85</span><span>High — regular relaxation practice needed</span></div>
          </div>
          <p style="margin-top:8px;font-size:12px;color:var(--muted)">Note: your personal baseline matters more than population averages. After 14 days of measurements the system learns your individual norm.</p>
        </div>
      </div>

      <button class="btn-primary" id="pulse-next-btn" onclick="goBreath()" disabled>Next — measure breathing →</button>
      <button onclick="cancelMeasure()" style="width:100%;padding:11px;background:var(--gl);border:1.5px solid var(--gb);border-radius:14px;font-size:13px;font-weight:500;color:var(--green);font-family:var(--font);cursor:pointer;margin-top:6px">&#10005; Cancel &mdash; back to start</button>
    </div>
  </div>

  <!-- STEP 2: BREATHING -->
  <div class="sec" id="s-breath">
    <div class="card">
      <div class="step-label">Step 2 of 2 · Breathing Rate</div>
      <div class="title">Count your breaths</div>
      <div class="sub">Stay in the same position. Don&rsquo;t change your breathing — just observe. Count each complete cycle (inhale + exhale = 1) for 1 minute.</div>
      <div class="hint"><span style="font-size:16px;flex-shrink:0">💡</span><span>This observation itself calms the nervous system — noticing the breath without changing it is a practice.</span></div>

      <div class="timer-wrap">
        <div class="timer-ring">
          <svg width="160" height="160" viewBox="0 0 160 160">
            <circle class="ring-bg" cx="80" cy="80" r="70"/>
            <circle class="ring-count" id="breath-ring" cx="80" cy="80" r="70" style="stroke-dashoffset:440"/>
          </svg>
          <div class="timer-num" id="breath-timer-num">1:00</div>
        </div>
        <div class="timer-sub" id="breath-timer-sub">Press Start when ready</div>
      </div>
      <div id="breath-screen-hint" class="hint" style="display:none"><span style="font-size:16px;flex-shrink:0">📵</span><span>You can lock your screen — a sound will signal when the minute is up.</span></div>
      <button class="btn-primary" id="breath-timer-btn" onclick="startBreathTimer()">▶ Start 1-minute count</button>

      <div id="breath-count-wrap" style="display:none">
        <div class="count-box">
          <div class="count-label">How many breaths did you count during 1 minute?</div>
          <input class="count-input" type="number" id="breath-val" placeholder="—" min="4" max="40" oninput="interpBreath()">
          <div class="count-unit">breaths per minute</div>
        </div>
        <div class="interp" id="interp-breath"></div>
      </div>

      <button class="why-btn" onclick="toggleWhy('why-breath')">💡 Why does breathing rate matter? ↓</button>
      <div class="why-panel" id="why-breath">
        <button class="listen-btn" onclick="speakWhy('why-breath-text',this)">🔊 Listen</button>
        <div id="why-breath-text">
          <p>At rest, a healthy breathing rate is <b>12–16 breaths per minute</b>. Above 16–18 means the system is chronically rushing even when there's nothing to rush for.</p>
          <p style="margin-top:8px">Fast breathing almost always means <b>chest breathing</b> — the diaphragm isn't fully engaging. This creates a loop: chest breathing activates the sympathetic nervous system → stress → chest breathing. The diaphragm loses mobility, internal abdominal pressure rises, organs get less massage from breathing movements.</p>
          <p style="margin-top:8px">Biochemically: when you over-breathe, CO₂ leaves the blood too fast, blood vessels narrow — paradoxically, you feel like you can't get enough air even though oxygen is fine. This is the <b>internal compression</b> that joint gymnastics and breathwork directly address.</p>
          <p style="margin-top:8px">One cycle of slow nasal breathing with belly movement switches the nervous system from sympathetic to parasympathetic in 2–3 minutes. <b>Svistyelka, slow exhales, full diaphragmatic breath</b> — these are the tools.</p>
          <div class="ranges">
            <div class="rng"><span class="rng-val g">Below 12</span><span>Excellent — diaphragm fully engaged</span></div>
            <div class="rng"><span class="rng-val ok">12–16</span><span>Normal</span></div>
            <div class="rng"><span class="rng-val w">16–20</span><span>Elevated — chest breathing dominant, diaphragm underused</span></div>
            <div class="rng"><span class="rng-val r">Above 20</span><span>High — chronic hyperventilation, high background stress</span></div>
          </div>
        </div>
      </div>

      <button class="btn-primary" id="breath-save-btn" onclick="saveMeasurements()" disabled>Save measurements →</button>
      <button onclick="cancelMeasure()" style="width:100%;padding:11px;background:var(--gl);border:1.5px solid var(--gb);border-radius:14px;font-size:13px;font-weight:500;color:var(--green);font-family:var(--font);cursor:pointer;margin-top:6px">&#10005; Cancel &mdash; back to start</button>
    </div>
  </div>

  <!-- RESULT -->
  <div class="sec" id="s-result">
    <div class="card">
      <div class="step-label">Today&rsquo;s measurements · saved</div>
      <div class="title">✓ All done</div>
      <div id="result-pulse-badge" class="interp show" style="margin-bottom:8px"></div>
      <div id="result-breath-badge" class="interp show" style="margin-bottom:1rem"></div>
      <div class="result-action" id="result-action"></div>
      <button class="btn-primary" onclick="window.location.href='/program'">Go to my program →</button>
      <button class="btn-amber" onclick="restart()">Measure again</button>
    </div>
  </div>
</div>

<script type="module" src="/firebase-auth.js"></script>
<script type="module">
import { auth, db } from '/firebase-auth.js';
import { doc, setDoc, arrayUnion } from 'https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js';

// inject logo
window.onMwAuthReady = function(user, profile) {
  var lw = document.getElementById('logo-wrap');
  if (lw && window._logoImg) lw.innerHTML = window._logoImg;
};

window.mwSaveMeasurement = async function(data) {
  try {
    const user = auth.currentUser;
    if (!user) return;
    const entry = Object.assign({}, data, { ts: new Date().toISOString() });
    await setDoc(doc(db, 'users', user.uid), {
      measurements: arrayUnion(entry)
    }, { merge: true });
    // mirror to checkin fields for program adaptation
    await setDoc(doc(db, 'users', user.uid), {
      lastMeasure: entry
    }, { merge: true });
  } catch(e) { console.log('measure save:', e); }
};
</script>
<script>
var pulseVal = null, breathVal = null;
var prepTimer = null, pulseTimer = null, breathTimer = null;

function show(id) {
  document.querySelectorAll('.sec').forEach(function(s){ s.classList.remove('active'); });
  document.getElementById(id).classList.add('active');
  window.scrollTo(0,0);
}

// ---- PREP TIMER ----
function skipPrep(){ show('s-pulse'); }
function startPrep() {
  var btn = document.getElementById('prep-btn');
  btn.disabled = true; btn.textContent = 'Resting…';
  runTimer(60, 'prep-ring', 'prep-num', '#A8D5B8', function(sec){
    document.getElementById('prep-sub').textContent = sec > 0 ? 'Resting… breathe and let go 🌿' : 'Ready — let\'s measure';
  }, function(){
    beep(); show('s-pulse');
  });
}

// ---- PULSE ----
function showManualPulse() {
  document.getElementById('manual-pulse-wrap').style.display = 'block';
}
function startPulseTimer() {
  var btn = document.getElementById('pulse-timer-btn');
  btn.disabled = true; btn.textContent = 'Counting…';
  document.getElementById('pulse-screen-hint').style.display = 'flex';
  runTimer(60, 'pulse-ring', 'pulse-timer-num', '#2D7D52', function(sec){
    document.getElementById('pulse-timer-sub').textContent = sec > 0 ? 'Keep counting — stay still 🤫' : 'Done!';
  }, function(){
    beep();
    document.getElementById('pulse-count-wrap').style.display = 'block';
    document.getElementById('pulse-screen-hint').style.display = 'none';
  });
}
function interpPulse() {
  var v = parseInt(document.getElementById('pulse-val').value);
  pulseVal = isNaN(v) ? null : v;
  var el = document.getElementById('interp-pulse');
  document.getElementById('pulse-next-btn').disabled = !pulseVal;
  if (!pulseVal) { el.className='interp'; return; }
  var cls,icon,title,sub;
  if (v < 60) { cls='great';icon='💚';title='Below 60 bpm · Excellent';sub='Nervous system recovers well. Vagus nerve is active.'; }
  else if (v <= 75) { cls='ok';icon='✅';title='60–75 bpm · Normal';sub='Good baseline. Regular practice will bring it lower over time.'; }
  else if (v <= 85) { cls='warn';icon='⚠️';title='75–85 bpm · Elevated';sub='Sympathetic nervous system is dominant. Body is in background tension.'; }
  else { cls='high';icon='🔴';title='Above 85 bpm · High';sub='Nervous system needs regular relaxation practice. Svistyelka and slow exhales will help.'; }
  el.className='interp show '+cls;
  el.innerHTML='<span class="interp-icon">'+icon+'</span><div class="interp-text"><b>'+title+'</b><small>'+sub+'</small></div>';
}
function goBreath() { show('s-breath'); }

// ---- BREATH ----
function startBreathTimer() {
  var btn = document.getElementById('breath-timer-btn');
  btn.disabled = true; btn.textContent = 'Counting…';
  document.getElementById('breath-screen-hint').style.display = 'flex';
  runTimer(60, 'breath-ring', 'breath-timer-num', '#2D7D52', function(sec){
    document.getElementById('breath-timer-sub').textContent = sec > 0 ? 'Observe only — don\'t change the breath 🌬️' : 'Done!';
  }, function(){
    beep();
    document.getElementById('breath-count-wrap').style.display = 'block';
    document.getElementById('breath-screen-hint').style.display = 'none';
  });
}
function interpBreath() {
  var v = parseInt(document.getElementById('breath-val').value);
  breathVal = isNaN(v) ? null : v;
  var el = document.getElementById('interp-breath');
  document.getElementById('breath-save-btn').disabled = !breathVal;
  if (!breathVal) { el.className='interp'; return; }
  var cls,icon,title,sub;
  if (v < 12) { cls='great';icon='💚';title='Below 12 / min · Excellent';sub='Diaphragm fully engaged. Deep, efficient breathing.'; }
  else if (v <= 16) { cls='ok';icon='✅';title='12–16 / min · Normal';sub='Healthy breathing rate at rest.'; }
  else if (v <= 20) { cls='warn';icon='⚠️';title='16–20 / min · Elevated';sub='Chest breathing is dominant. Diaphragm is underused — internal compression.'; }
  else { cls='high';icon='🔴';title='Above 20 / min · High';sub='Chronic hyperventilation pattern. High background stress. Breathwork is the priority.'; }
  el.className='interp show '+cls;
  el.innerHTML='<span class="interp-icon">'+icon+'</span><div class="interp-text"><b>'+title+'</b><small>'+sub+'</small></div>';
}

// ---- SAVE ----
function saveMeasurements() {
  var pulse = parseInt(document.getElementById('pulse-val').value);
  var breath = parseInt(document.getElementById('breath-val').value);
  if (!pulse || !breath) return;
  // determine session recommendation
  var mode='reset', action='';
  if (pulse > 85 || breath > 20) {
    mode='restore';
    action='<b>→ Restore mode today</b> · Svistyelka opening · slow joint gymnastics · Shavasana close<br><span style="font-size:12px;color:var(--muted)">20 min · breath-guided · eyes can be closed</span>';
  } else if (pulse > 75 || breath > 16) {
    mode='restore';
    action='<b>→ Restore mode recommended</b> · Both readings are elevated. Gentle practice today will bring them down.<br><span style="font-size:12px;color:var(--muted)">20–30 min · Svistyelka focus</span>';
  } else if (pulse < 60 && breath < 12) {
    mode='reset';
    action='<b>→ Reset session — excellent day for it ✨</b> · Your nervous system is calm and ready. Good day to try Impulse Breathing in the opening.<br><span style="font-size:12px;color:var(--muted)">30 min · full joint cycle</span>';
  } else {
    mode='reset';
    action='<b>→ Reset session today</b> · Both readings look balanced. Full joint cycle with breathwork.<br><span style="font-size:12px;color:var(--muted)">30 min</span>';
  }
  // result badges
  var pb = document.getElementById('result-pulse-badge');
  var bb = document.getElementById('result-breath-badge');
  var pInterp = document.getElementById('interp-pulse').innerHTML;
  var bInterp = document.getElementById('interp-breath').innerHTML;
  pb.className = 'interp show ' + (pulse < 60?'great':pulse<=75?'ok':pulse<=85?'warn':'high');
  pb.innerHTML = pInterp;
  bb.className = 'interp show ' + (breath < 12?'great':breath<=16?'ok':breath<=20?'warn':'high');
  bb.innerHTML = bInterp;
  document.getElementById('result-action').innerHTML = action;
  // save to Firestore
  if (window.mwSaveMeasurement) window.mwSaveMeasurement({ pulse: pulse, breath: breath, mode: mode });
  // also update today's program via sessionStorage
  try { sessionStorage.setItem('mw_measure', JSON.stringify({ pulse:pulse, breath:breath, mode:mode })); } catch(e){}
  show('s-result');
}

function restart() {
  pulseVal = null; breathVal = null;
  document.getElementById('pulse-val').value = '';
  document.getElementById('breath-val').value = '';
  document.getElementById('interp-pulse').className = 'interp';
  document.getElementById('interp-breath').className = 'interp';
  document.getElementById('pulse-next-btn').disabled = true;
  document.getElementById('breath-save-btn').disabled = true;
  document.getElementById('manual-pulse-wrap').style.display = 'none';
  document.getElementById('breath-count-wrap').style.display = 'none';
  document.getElementById('prep-btn').disabled = false;
  document.getElementById('prep-btn').textContent = '▶ Start 1-minute rest';
  document.getElementById('prep-num').textContent = '1:00';
  document.getElementById('prep-sub').textContent = 'Press Start when comfortable';
  document.getElementById('prep-ring').style.strokeDashoffset = '440';
  show('s-prep');
}

// ---- WHY TOGGLE ----
function toggleWhy(id) {
  var el = document.getElementById(id);
  el.classList.toggle('open');
}
function speakWhy(id, btn) {
  var el = document.getElementById(id);
  if (!el) return;
  if (window.speechSynthesis.speaking) { window.speechSynthesis.cancel(); btn.textContent='🔊 Listen'; return; }
  var u = new SpeechSynthesisUtterance(el.textContent);
  u.rate=0.9; u.lang='en-US';
  u.onend=function(){ btn.textContent='🔊 Listen'; };
  window.speechSynthesis.speak(u);
  btn.textContent='⏹ Stop';
}

// ---- TIMER ENGINE ----
var activeTimer = null;
function runTimer(seconds, ringId, numId, color, onTick, onDone) {
  var ring = document.getElementById(ringId);
  var num = document.getElementById(numId);
  var total = seconds, rem = seconds;
  var circ = 440;
  if (ring) ring.style.stroke = color;
  var iv = setInterval(function(){
    rem--;
    var pct = (total - rem) / total;
    if (ring) ring.style.strokeDashoffset = circ * (1 - pct);
    var m = Math.floor(rem/60), s = rem%60;
    if (num) num.textContent = m + ':' + (s<10?'0':'') + s;
    if (onTick) onTick(rem);
    if (rem <= 0) { clearInterval(iv); activeTimer = null; if (onDone) onDone(); }
  }, 1000);
  activeTimer = iv;
}

function cancelMeasure(){
  if (activeTimer) { clearInterval(activeTimer); activeTimer = null; }
  show('s-prep');
}

// ---- BEEP ----
function beep() {
  try {
    var ctx = new (window.AudioContext||window.webkitAudioContext)();
    var o = ctx.createOscillator(); var g = ctx.createGain();
    o.connect(g); g.connect(ctx.destination);
    o.frequency.value = 880; g.gain.value = 0.3;
    o.start(); g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime+0.8);
    o.stop(ctx.currentTime+0.8);
  } catch(e){}
}

