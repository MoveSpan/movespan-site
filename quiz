<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Body Awareness Quiz — MoveSpan System</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --green: #2D7D52; --green-light: #E8F5EE; --green-border: #A8D5B8;
    --text: #1A1A1A; --text-sec: #5A6370; --text-muted: #9AA3AD;
    --border: #E2E6EA; --surface: #F7F9FB; --white: #FFFFFF;
    --radius: 14px; --font: 'Inter', system-ui, sans-serif;
  }
  body { font-family: var(--font); background: var(--surface); color: var(--text); min-height: 100vh; }
  .wrap { max-width: 560px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }

  /* HEADER */
  .logo { display: flex; align-items: center; gap: 8px; margin-bottom: 2rem; }
  .logo-icon { width: 34px; height: 34px; overflow:hidden; border-radius: 9px; display: flex; align-items: center; justify-content: center; color: white; font-size: 17px; }
  .logo-name { font-size: 15px; font-weight: 600; color: var(--text); }

  /* PROGRESS */
  .progress-wrap { height: 4px; background: var(--border); border-radius: 2px; margin-bottom: .6rem; }
  .progress { height: 4px; background: var(--green); border-radius: 2px; transition: width .5s ease; }
  .step-label { font-size: 12px; color: var(--text-muted); margin-bottom: 2rem; }

  /* CARD */
  .card { background: var(--white); border-radius: 20px; padding: 2rem 1.75rem; box-shadow: 0 1px 6px rgba(0,0,0,.07); }

  /* QUESTION */
  .q-emoji { font-size: 36px; margin-bottom: 1rem; display: block; }
  .q-tag { font-size: 11px; font-weight: 500; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 8px; }
  .q-text { font-size: 20px; font-weight: 600; color: var(--text); line-height: 1.35; margin-bottom: 1.75rem; letter-spacing: -.02em; }

  /* OPTIONS */
  .options { display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.5rem; }
  .option { background: var(--surface); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 14px 16px; font-size: 15px; color: var(--text-sec); cursor: pointer; transition: all .15s; text-align: left; font-family: var(--font); }
  .option:hover { border-color: var(--green-border); color: var(--text); background: var(--green-light); }
  .option.selected { border-color: var(--green); background: var(--green-light); color: var(--green); font-weight: 500; }

  /* INSIGHT */
  .insight { display: none; background: var(--green-light); border: 1.5px solid var(--green-border); border-radius: var(--radius); padding: 16px 18px; margin-bottom: 1.5rem; }
  .insight.show { display: block; animation: fadeIn .3s ease; }
  .insight-label { font-size: 11px; font-weight: 600; color: var(--green); text-transform: uppercase; letter-spacing: .06em; margin-bottom: 6px; }
  .insight-text { font-size: 14px; color: var(--text-sec); line-height: 1.7; }
  .insight-text b { color: var(--text); }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

  /* BUTTONS */
  .btn-next { width: 100%; padding: 14px; background: var(--green); color: white; border: none; border-radius: var(--radius); font-size: 15px; font-weight: 500; font-family: var(--font); cursor: pointer; transition: opacity .15s; display: none; }
  .btn-next.show { display: block; animation: fadeIn .2s ease; }
  .btn-next:hover { opacity: .88; }

  /* SUCCESS */
  .success { display: none; text-align: center; padding: 1rem 0; }
  .success.show { display: block; }
  .success-emoji { font-size: 56px; margin-bottom: 1rem; display: block; }
  .success-title { font-size: 24px; font-weight: 600; color: var(--text); margin-bottom: 8px; letter-spacing: -.02em; }
  .success-sub { font-size: 15px; color: var(--text-sec); line-height: 1.6; margin-bottom: 2rem; }
  .btn-cta { display: inline-block; padding: 14px 28px; background: var(--green); color: white; border-radius: var(--radius); font-size: 15px; font-weight: 500; text-decoration: none; transition: opacity .15s; }
  .btn-cta:hover { opacity: .88; }

  /* SCORE */
  .score-bar { display: flex; gap: 6px; margin-bottom: 1.5rem; }
  .score-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--border); transition: background .3s; }
  .score-dot.done { background: var(--green); }
</style>
</head>
<body>
<div class="wrap">
  <div class="logo">
    <div class="logo-icon"><img src="data:image/png;base64," style="width:100%;height:100%;object-fit:cover;display:block;" alt="MoveSpan"></div>
    <span class="logo-name">MoveSpan System</span>
  </div>

  <div class="progress-wrap"><div class="progress" id="progress" style="width:0%"></div></div>
  <div class="step-label" id="step-label">Question 1 of 6</div>

  <div class="card">
    <div class="score-bar" id="score-bar"></div>

    <!-- QUESTIONS -->
    <div id="quiz-content">
      <span class="q-emoji" id="q-emoji"></span>
      <div class="q-tag" id="q-tag"></div>
      <div class="q-text" id="q-text"></div>
      <div class="options" id="options"></div>
      <div class="insight" id="insight">
        <div class="insight-label">Here's what research shows</div>
        <div class="insight-text" id="insight-text"></div>
      </div>
      <button class="btn-next" id="btn-next" onclick="nextQ()">Continue →</button>
    </div>

    <!-- SUCCESS -->
    <div class="success" id="success">
      <span class="success-emoji">🌿</span>
      <div class="success-title">You're ready to begin</div>
      <div class="success-sub">Now you have a clearer picture of how your body works — and what's possible. MoveSpan System is built around these exact insights.<br><br>Let's find out your biological body age and build your personal program.</div>
      <a href="/" class="btn-cta">Start My Body Age Test →</a>
    </div>
  </div>
</div>

<script>
const questions = [
  {
    emoji: '💪',
    tag: 'Fitness & joints',
    text: 'If someone works out regularly and feels strong — are their joints and spine protected?',
    options: ['Yes, definitely', 'I\'m not sure', 'I think not'],
    insight: `<b>Muscle strength and joint health are two different things.</b> Fitness primarily trains fast, superficial muscles. But it's the deep stabiliser muscles that protect your spine and joints — and most standard workouts barely touch them. You can be physically strong and still have vulnerable joints.`
  },
  {
    emoji: '🔍',
    tag: 'Hidden patterns',
    text: 'Have you ever considered that headaches, chronic fatigue, or morning stiffness might not be "just age" — but signals your body has been sending for years?',
    options: ['Yes, I\'ve thought about this', 'Sometimes I notice, but don\'t connect it', 'Never looked at it this way'],
    insight: `Most people treat the symptom — a painkiller for the headache, a cream for the neck. But behind many of these symptoms is one root cause: <b>invisible movement patterns</b> in how we walk, breathe and hold our bodies. We don't even notice them. They become our "normal." And over time, they quietly drain our energy, clarity and capacity to live fully.`
  },
  {
    emoji: '🫁',
    tag: 'Breathing',
    text: 'Did you know that the way you breathe right now affects your energy levels, focus — and even the health of your spine?',
    options: ['Yes, I\'m aware', 'I\'ve heard about stress, but not the spine', 'Never thought about it'],
    insight: `Most people breathe shallowly — from the chest, barely using the diaphragm. But <b>the diaphragm isn't just a breathing muscle — it's a spinal stabiliser.</b> When it's underused, posture suffers, anxiety increases, and both focus and energy drop. All from something as basic as how you inhale.`
  },
  {
    emoji: '⚡',
    tag: 'Energy',
    text: 'Have you ever felt that your energy is low — not because of too much work, but simply because your body isn\'t giving it to you?',
    options: ['Yes, I know this feeling', 'Sometimes', 'No, my energy is fine'],
    insightPersonal: {
      0: `That tiredness which doesn't go away after rest is one of your body's most honest signals. It's not weakness or laziness. <b>It means your body is working inefficiently</b> — shallow breathing, chronically tense muscles, an overloaded nervous system. The good news: this changes faster than most people expect.`,
      1: `"Sometimes" often becomes "always" — so gradually you don't notice the shift. <b>The body adapts to a lower energy level and starts treating it as normal.</b> But it isn't. It's a signal that your body's resources aren't being fully used.`,
      2: `Great. And yet — is there a ceiling on your energy? <b>Most people operate at 60–70% of their real capacity,</b> simply not knowing what's possible. MoveSpan isn't about recovering your energy. It's about unlocking the level that was always there.`
    }
  },
  {
    emoji: '⏳',
    tag: 'Longevity',
    text: 'What matters more to you — living a long life, or living a full one?',
    options: ['Long — time is the most precious resource', 'Full — quality over quantity', 'You can\'t truly separate the two'],
    insight: `Here's a paradox: people who focus on longevity as a goal often end up living with restriction and anxiety. But those who simply choose to <b>live fully — to move, breathe, feel, be present</b> — tend to live both longer and better. Longevity isn't achieved directly. It arrives as a result of the quality of your daily life. Not despite pleasure — through it.`
  },
  {
    emoji: '🧭',
    tag: 'Your body as a resource',
    text: 'Does your body have an expiration date? Or is it a question of how you use it?',
    options: ['It has a fixed lifespan — that\'s just nature', 'It depends on genetics and lifestyle', 'I\'ve never thought of it as something I manage'],
    insight: `Genetics determines about 20–30% of how your body ages. <b>The rest is how you use it every day.</b> Your body doesn't wear out from use — it degrades from wrong use, and thrives with the right kind. Most people carefully manage their finances, time and career — but let their body run on autopilot. Yet the body is the foundation of everything else: energy, clarity, relationships, and the ability to do what matters most. <b>MoveSpan is about building a reserve of movement, energy and clarity — for the decades ahead.</b>`
  }
];

let current = 0;
let selectedOption = null;

function init() {
  // Build score dots
  const bar = document.getElementById('score-bar');
  bar.innerHTML = questions.map((_,i) => `<div class="score-dot" id="dot-${i}"></div>`).join('');
  renderQ();
}

function renderQ() {
  const q = questions[current];
  const pct = Math.round((current / questions.length) * 100);

  document.getElementById('progress').style.width = pct + '%';
  document.getElementById('step-label').textContent = `Question ${current + 1} of ${questions.length}`;
  document.getElementById('q-emoji').textContent = q.emoji;
  document.getElementById('q-tag').textContent = q.tag;
  document.getElementById('q-text').textContent = q.text;

  const opts = document.getElementById('options');
  opts.innerHTML = q.options.map((o, i) =>
    `<button class="option" onclick="selectOption(${i})">${o}</button>`
  ).join('');

  document.getElementById('insight').className = 'insight';
  document.getElementById('insight-text').innerHTML = '';
  document.getElementById('btn-next').className = 'btn-next';
  selectedOption = null;
}

function selectOption(idx) {
  selectedOption = idx;
  document.querySelectorAll('.option').forEach((b, i) => {
    b.classList.toggle('selected', i === idx);
  });

  const q = questions[current];
  const insight = q.insightPersonal ? q.insightPersonal[idx] : q.insight;
  document.getElementById('insight-text').innerHTML = insight;
  document.getElementById('insight').className = 'insight show';
  document.getElementById('btn-next').className = 'btn-next show';

  document.getElementById(`dot-${current}`).classList.add('done');
}

function nextQ() {
  current++;
  if (current >= questions.length) {
    showSuccess();
  } else {
    document.getElementById('progress').style.width = Math.round((current / questions.length) * 100) + '%';
    document.getElementById('step-label').textContent = `Question ${current + 1} of ${questions.length}`;
    renderQ();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }
}

function showSuccess() {
  document.getElementById('progress').style.width = '100%';
  document.getElementById('step-label').textContent = '✓ Complete';
  document.getElementById('quiz-content').style.display = 'none';
  document.getElementById('success').className = 'success show';
  document.querySelectorAll('.score-dot').forEach(d => d.classList.add('done'));
}

init();
</script>
</body>
</html>
