<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Equipment — Move Well System</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  :root {
    --green: #2D7D52; --green-light: #E8F5EE; --green-border: #A8D5B8;
    --text: #1A1A1A; --text-sec: #5A6370; --text-muted: #9AA3AD;
    --border: #E2E6EA; --surface: #F7F9FB; --white: #FFFFFF;
    --radius: 12px; --font: 'Inter', system-ui, sans-serif;
    --orange: #F59E0B; --orange-light: #FEF3C7;
    --red: #EF4444; --red-light: #FEE2E2;
  }
  body { font-family: var(--font); background: var(--surface); color: var(--text); min-height: 100vh; }
  .wrap { max-width: 720px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }

  /* HEADER */
  .header { text-align: center; margin-bottom: 2rem; }
  .logo { display: inline-flex; align-items: center; gap: 8px; margin-bottom: 1.5rem; }
  .logo-icon { width: 36px; height: 36px; background: var(--green); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 18px; }
  .logo-name { font-size: 15px; font-weight: 600; color: var(--text); }
  .header-title { font-size: 26px; font-weight: 600; color: var(--text); margin-bottom: 8px; letter-spacing: -.02em; }
  .header-sub { font-size: 14px; color: var(--text-sec); line-height: 1.6; max-width: 480px; margin: 0 auto; }

  /* HAVE COUNTER */
  .have-bar { background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 14px 18px; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; }
  .have-bar-left { font-size: 14px; color: var(--text-sec); }
  .have-count { font-size: 22px; font-weight: 600; color: var(--green); }

  /* FILTERS */
  .filter-bar { display: flex; gap: 8px; margin-bottom: 1.5rem; flex-wrap: wrap; }
  .filter-btn { background: var(--white); border: 1.5px solid var(--border); border-radius: 40px; padding: 7px 16px; font-size: 13px; font-family: var(--font); cursor: pointer; color: var(--text-sec); transition: all .15s; }
  .filter-btn:hover { border-color: var(--green); color: var(--text); }
  .filter-btn.active { background: var(--green-light); color: var(--green); border-color: var(--green-border); font-weight: 500; }

  /* GRID */
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 12px; margin-bottom: 2rem; }

  /* CARD */
  .card { background: var(--white); border: 1.5px solid var(--border); border-radius: 16px; padding: 16px; transition: all .15s; display: flex; flex-direction: column; }
  .card:hover { border-color: #CBD5E1; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
  .card.have { border-color: var(--green-border); background: var(--green-light); }
  .card-emoji { font-size: 28px; margin-bottom: 10px; }
  .card-name { font-size: 14px; font-weight: 600; color: var(--text); margin-bottom: 4px; line-height: 1.3; }
  .card-use { font-size: 12px; color: var(--text-sec); line-height: 1.55; margin-bottom: 12px; flex: 1; }
  .priority { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 500; padding: 3px 8px; border-radius: 20px; margin-bottom: 10px; }
  .priority.must { background: var(--red-light); color: var(--red); }
  .priority.rec { background: var(--orange-light); color: var(--orange); }
  .priority.opt { background: var(--surface); color: var(--text-muted); border: 1px solid var(--border); }
  .tip { font-size: 11px; color: var(--green); background: var(--green-light); border-radius: 8px; padding: 5px 8px; margin-bottom: 8px; }

  .btn-have { width: 100%; padding: 9px; border-radius: var(--radius); font-size: 13px; font-weight: 500; font-family: var(--font); cursor: pointer; transition: all .15s; border: 1.5px solid var(--border); background: var(--white); color: var(--text-sec); margin-bottom: 6px; }
  .btn-have:hover { border-color: var(--green); color: var(--green); }
  .card.have .btn-have { background: var(--green); color: white; border-color: var(--green); }
  .btn-buy { display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; padding: 9px; background: #FF9900; color: white; border: none; border-radius: var(--radius); font-size: 13px; font-weight: 500; font-family: var(--font); cursor: pointer; text-decoration: none; transition: opacity .15s; }
  .btn-buy:hover { opacity: .88; }
  .card.have .btn-buy { display: none; }

  /* SECTION */
  .section-title { font-size: 12px; font-weight: 500; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; margin: 1.5rem 0 .75rem; }

  /* AMAZON LIST LINK */
  .amazon-link { text-align: center; background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius); padding: 16px; margin-top: 1rem; }
  .amazon-link a { color: var(--green); text-decoration: none; font-size: 14px; font-weight: 500; }
  .amazon-link p { font-size: 12px; color: var(--text-muted); margin-top: 4px; }

  @media(max-width:480px) { .grid { grid-template-columns: 1fr 1fr; } }
</style>
</head>
<body>
<div class="wrap">

  <div class="header">
    <div class="logo">
      <div class="logo-icon"><img src="data:image/png;base64," style="width:100%;height:100%;object-fit:cover;display:block;" alt="MoveSpan"></div>
      <span class="logo-name">Move Well System</span>
    </div>
    <h1 class="header-title">Your Practice Equipment</h1>
    <p class="header-sub">Mark what you already have at home — the system will build your program around it. Get what's missing with one click.</p>
  </div>

  <div class="have-bar">
    <div class="have-bar-left">Items you already have at home</div>
    <div class="have-count" id="have-count">0</div>
  </div>

  <div class="filter-bar">
    <button class="filter-btn active" onclick="filter('all')">All</button>
    <button class="filter-btn" onclick="filter('essential')">Essential</button>
    <button class="filter-btn" onclick="filter('body')">Body & Fascia</button>
    <button class="filter-btn" onclick="filter('mobility')">Mobility</button>
    <button class="filter-btn" onclick="filter('breath')">Breath & Neuro</button>
  </div>

  <div class="grid" id="grid"></div>

  <div class="amazon-link">
    <a href="https://www.amazon.com/hz/wishlist/ls/2T0P3SGESSY4Y" target="_blank">🛒 View full Move Well System equipment list on Amazon</a>
    <p>All items are personally selected and used by the Move Well System instructor</p>
  </div>

</div>

<script>
const items = [
  // ESSENTIAL
  { id:'mat', emoji:'🧘', name:'Yoga Mat', cat:'essential', priority:'must',
    use:'The foundation of every practice. Needed for joint gymnastics, floor exercises and meditation.',
    tip:'You might already have one at home!', amazon:null },

  { id:'bottle15', emoji:'💧', name:'1.5L Water Bottle', cat:'essential', priority:'must',
    use:'Use as a back roller or for gentle belly massage using the neck of the bottle. Already in your home.',
    tip:'Already at home — no need to buy!', amazon:null },

  { id:'bottle05', emoji:'🏋️', name:'0.5L Bottles × 2', cat:'essential', priority:'must',
    use:'Lightweight dumbbells for resistance exercises. A simple and effective substitute.',
    tip:'Already at home — no need to buy!', amazon:null },

  { id:'metronome', emoji:'🎵', name:'Metronome App', cat:'breath', priority:'must',
    use:'For breathing practices: Box Breathing, stepped breathing and other rhythmic techniques.',
    tip:'Free app on your phone!', amazon:null },

  // BODY & FASCIA
  { id:'roller', emoji:'🔵', name:'Foam Roller', cat:'body', priority:'must',
    use:'Myofascial release for back, hips and calves. Relieves chronic tension and improves circulation.',
    amazon:'https://www.amazon.com/dp/B00XM2MXK8/' },

  { id:'peanut', emoji:'🥜', name:'Double Lacrosse Ball (Peanut)', cat:'body', priority:'rec',
    use:'Works along the spine for targeted decompression of each vertebra. Great for the thoracic spine.',
    amazon:'https://www.amazon.com/dp/B08F47Q28Q/' },

  { id:'tennis', emoji:'🎾', name:'Tennis Ball', cat:'body', priority:'must',
    use:'Trigger point release for feet, glutes and shoulders. Soft pressure, great for beginners.',
    tip:'Can be found at any sports store', amazon:null },

  { id:'spiky', emoji:'⚡', name:'Spiky Massage Ball Set', cat:'body', priority:'rec',
    use:'More intensive fascia work. Spikes increase blood flow and release deep muscle tension.',
    amazon:'https://www.amazon.com/dp/B0759KK3HS/' },

  { id:'acupoint', emoji:'🔴', name:'Acupoint Massage Ball Set', cat:'body', priority:'rec',
    use:'Multi-density ball set for different body zones. Smooth to spiky — from gentle to deep work.',
    amazon:'https://www.amazon.com/dp/B01IL7SKUU/' },

  { id:'stick', emoji:'🪄', name:'Wooden Pranayama Stick', cat:'body', priority:'opt',
    use:'Self-massage for legs and back. Also used in qigong movement sequences. Foldable for travel.',
    amazon:'https://www.amazon.com/dp/B0CC63JZR4/' },

  { id:'lyapko', emoji:'🌿', name:'LYAPKO Acupuncture Mat', cat:'body', priority:'opt',
    use:'Metal needle applicator — more intensive than Kuznetsov. Relieves muscle spasms and activates reflexes.',
    amazon:'https://www.amazon.com/dp/B06ZXRW5TZ/' },

  // MOBILITY
  { id:'wheel', emoji:'⭕', name:'Yoga Wheel', cat:'mobility', priority:'rec',
    use:'Opens the thoracic spine, gentle back bends, spinal decompression. One of the most effective tools for posture.',
    amazon:'https://www.amazon.com/dp/B0BWJT77L5/' },

  { id:'block', emoji:'🧱', name:'Yoga Block (pair)', cat:'mobility', priority:'opt',
    use:'Support and alignment in flexibility exercises. Makes poses accessible and safe for all levels.',
    amazon:'https://www.amazon.com/dp/B01FN7X7KE/' },

  { id:'strap', emoji:'➰', name:'Yoga Strap', cat:'mobility', priority:'opt',
    use:'Safe flexibility work, especially for the posterior chain. Extends reach without straining muscles.',
    amazon:null },

  { id:'balance', emoji:'🫧', name:'Balance Cushion', cat:'mobility', priority:'opt',
    use:'Balance training, proprioception and foot activation. Strengthens neuromuscular control.',
    amazon:null },

  // BREATH & NEURO
  { id:'band', emoji:'🔗', name:'Resistance Bands Set', cat:'breath', priority:'rec',
    use:'For mobility, muscle activation and resistance work. Different resistance levels for progression.',
    amazon:'https://www.amazon.com/hz/wishlist/ls/2T0P3SGESSY4Y' },
];

let haveSet = new Set();
let currentFilter = 'all';

function filter(cat) {
  currentFilter = cat;
  document.querySelectorAll('.filter-btn').forEach(b => {
    b.classList.toggle('active', b.textContent === {
      all:'All', essential:'Essential', body:'Body & Fascia', mobility:'Mobility', breath:'Breath & Neuro'
    }[cat]);
  });
  render();
}

function toggleHave(id) {
  if (haveSet.has(id)) haveSet.delete(id);
  else haveSet.add(id);
  document.getElementById('have-count').textContent = haveSet.size;
  render();
}

function render() {
  const grid = document.getElementById('grid');
  const filtered = currentFilter === 'all' ? items : items.filter(i => i.cat === currentFilter);
  const pLabel = { must:'Essential', rec:'Recommended', opt:'Optional' };

  grid.innerHTML = filtered.map(item => {
    const have = haveSet.has(item.id);
    return `
    <div class="card ${have ? 'have' : ''}">
      <div class="card-emoji">${item.emoji}</div>
      <div class="priority ${item.priority}">${pLabel[item.priority]}</div>
      <div class="card-name">${item.name}</div>
      <div class="card-use">${item.use}</div>
      ${item.tip ? `<div class="tip">✓ ${item.tip}</div>` : ''}
      <button class="btn-have" onclick="toggleHave('${item.id}')">
        ${have ? '✓ I have this' : '+ I have this'}
      </button>
      ${item.amazon && !have
        ? `<a class="btn-buy" href="${item.amazon}" target="_blank">🛒 Buy on Amazon</a>`
        : ''}
    </div>`;
  }).join('');
}

render();
</script>
</body>
</html>
